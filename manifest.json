{
  "manifest_version": 3,
  "name": "Luider",
  "version": "1.0.0",
  "description": "Turn a tab up past 100%. One slider, nothing else.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Luider: louder tab",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "luider@katteke.com", "strict_min_version": "121.0" }
  }
}
